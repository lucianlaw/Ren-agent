# 运行时数据：口令、会话、API Key、员工、任务轨迹
data/

# 工作区：用户在里面的文件不进仓库，只保留说明
workspace/*
!workspace/README.md

node_modules/
.DS_Store
*.log
.env

# 只读自审令牌（随部署目录下发，不进版本库）
self-token.json

# 密钥目录：与部署目录同级。永远不进仓库，也不该进部署包
.ren-secrets/

# 状态库（任务注册表 / 锁 / 限流计数），同样在部署目录之外
.ren-state/

# 发布标记：每次发布由 scripts/release.mjs 生成，不进版本库
build.json

# 本地运行时日志
nohup.out
*.out

# 本机维护者名单。admins.json 在仓库里只是空模板，真名单放这里
admins.local.json

# WorkBuddy 的工作区记忆，属于本机，不属于这个项目
.workbuddy/

# 平台应用标记：里面有本机绝对路径
*.genie

# 本地幻灯片工具日志
.slidep/

# 内部产物：从实现反推的 PRD 还没决定要不要公开，先留在本机
docs/PRD-ren-agent.md
